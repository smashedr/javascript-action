    "@actions/exec": "^2.0.0",
    "@actions/github": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "rollup": "^4.55.1"
  }
}
